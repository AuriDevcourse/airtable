# Copy to .env.local and fill in. NEVER commit .env.local.
# Airtable Personal Access Token. Needs data.records:read (public feeds) and
# data.records:write (the speaker sync writes into Marketing Project Overview).
AIRTABLE_TOKEN=patXXXXXXXX.XXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXX

AIRTABLE_SPEAKERS_TABLE=Speakers
# Only records with THIS checkbox ticked are ever returned to the public.
AIRTABLE_GATE_FIELD=On Website?

# In production set to your WordPress origin, e.g. https://techbbq.dk
ALLOWED_ORIGIN=*

# NISS 2026 (Nordic India Startup Summit Registrants). The gate is VIEW membership,
# not a status field. Table + view are pinned in lib/niss.ts; these are informational.
AIRTABLE_NISS_TABLE=tblfIPjV4t1c1628h
AIRTABLE_NISS_VIEW=viwRMZMX5NeN68XX7

# Speaker Hub — live TechBBQ Speakers 2026 roster. Supabase app (NOT Airtable).
# Reads the public `speaker_public_profiles` view with the anon/publishable key.
SPEAKERHUB_SUPABASE_URL=https://XXXXXXXX.supabase.co
SPEAKERHUB_SUPABASE_ANON_KEY=eyJXXXXXXXX

# Gates the /api/sync-speakers route (Supabase Speaker Hub -> Airtable). Vercel Cron
# and the GitHub Actions pinger send it as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=XXXXXXXX

# Brella API key (Admin Panel -> API Key -> Create Key; shown once). Read-only use here:
# the /program "TechBBQ 2026 (Brella)" tab reads the live schedule from the attendee app.
# Org 109 / event 10356 are pinned in lib/brellaprogram.ts. NOTE the same key can also
# CREATE and DELETE speakers, sponsors and sessions in the live event — treat as a password.
BRELLA_API_KEY=XXXXXXXX

# Tito (ti.to) Admin API secret key — powers the /lookup ticket search for support.
# Account slug `techbbq`; events searched are pinned in lib/tito.ts. Attendee data is
# PII, so /api/tito-lookup is NOT in middleware's PUBLIC_PATHS: it stays behind
# DASHBOARD_PASSWORD and is never embeddable. Unset = /lookup returns 503, never
# a misleading "no ticket found".
TITO_API_TOKEN=XXXXXXXX

# Password for the dashboard PAGES (Basic auth prompt; any username works). Also what
# authorizes the "Sync now" button via /api/admin/sync. The public read feeds are NOT
# gated by this — the techbbq.dk embeds must keep working. See middleware.ts.
# MUST be set in production: with it unset, the pages fail closed and return 401.
DASHBOARD_PASSWORD=XXXXXXXX

